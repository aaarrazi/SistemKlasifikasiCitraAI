# =====================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# =====================================================================

# --- Model (arsitektur.md §2.3 — A9) ---
MODEL_PATH=./ModelKlasifikasiGenerativeAIfix3.keras
# WAJIB dibuat dari skrip training, mis. print(train_generator.class_indices)
CLASS_INDICES_PATH=./class_indices.json

# --- Kontrak input model (A1) ---
IMG_SIZE=224

# --- Batasan file (A5) ---
MAX_UPLOAD_MB=10

# --- Face Gate (arsitektur.md §7.2) ---
# auto | mediapipe | opencv_dnn | off  (off => semua prediksi DITOLAK, fail-closed)
FACE_DETECTOR=auto
# model BlazeFace — diunduh sekali: python scripts/download_face_model.py
FACE_MODEL_PATH=./models/blaze_face_short_range.tflite
FACE_GATE_MIN_CONF=0.70
FACE_GATE_MIN_COVERAGE=0.15
FACE_GATE_MAX_COVERAGE=0.75

# --- Ambang confidence (arsitektur.md §7.5) ---
CONF_HIGH=0.70
CONF_MEDIUM=0.40

# --- Runtime ---
# true  : aplikasi LANGSUNG BERHENTI bila model/label/detektor gagal dimuat (produksi)
# false : aplikasi tetap jalan; endpoint prediksi membalas 503 + alasan (pengembangan)
STRICT_STARTUP=false
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Fase 8: riwayat, batch & proteksi ---
HISTORY_ENABLED=true
DATABASE_PATH=./storage/history.db
# permintaan /api/ per IP per menit; 0 = nonaktif (dipantau lewat header Retry-After)
RATE_LIMIT_PER_MINUTE=60
BATCH_MAX_FILES=10
